// SPI and GPIO variables
int spi_fd;
int gpio_fd;

// SPI settings
static uint32_t mode = SPI_MODE_0;
static uint8_t bits = 8;
static uint32_t speed = 10000000; // 10 MHz as per device tree
static uint16_t delay = 0;

// SSD1306 OLED settings
#define OLED_WIDTH 128
#define OLED_HEIGHT 64
#define OLED_PAGES 8 // 64 pixels / 8 bits per page

// Function to write to GPIO
void gpio_write(int fd, int value) {
    char buf[2] = { value ? '1' : '0', '\0' };
    write(fd, buf, 2);
    lseek(fd, 0, SEEK_SET);
}

// Function to send SPI data
int spi_write(uint8_t *data, int len, int dc) {
    struct spi_ioc_transfer tr = {
        .tx_buf = (unsigned long)data,
        .rx_buf = 0,
        .len = len,
        .delay_usecs = delay,
        .speed_hz = speed,
        .bits_per_word = bits,
    };

    gpio_write(gpio_fd, dc); // Set DC pin (0 for command, 1 for data)
    int ret = ioctl(spi_fd, SPI_IOC_MESSAGE(1), &tr);
    if (ret < 0) {
        perror("SPI write failed");
        return -1;
    }
    return 0;
}

// Send a single command to SSD1306
void oled_write_command(uint8_t cmd) {
    spi_write(&cmd, 1, 0);
}

// Send data to SSD1306
void oled_write_data(uint8_t *data, int len) {
    spi_write(data, len, 1);
}

// Initialize SSD1306 OLED
void oled_init() {
    // SSD1306 initialization sequence
    uint8_t init_cmds[] = {
        0xAE,       // Display OFF
        0xD5, 0x80, // Set display clock divide ratio/oscillator frequency
        0xA8, 0x3F, // Set multiplex ratio (64)
        0xD3, 0x00, // Set display offset
        0x40,       // Set start line
        0x8D, 0x14, // Charge pump setting (enable)
        0x20, 0x00, // Memory addressing mode (horizontal)
        0xA1,       // Segment re-map
        0xC8,       // COM output scan direction
        0xDA, 0x12, // COM pins hardware configuration
        0x81, 0xCF, // Contrast control
        0xD9, 0xF1, // Pre-charge period
        0xDB, 0x40, // VCOMH deselect level
        0xA4,       // Entire display ON
        0xA6,       // Normal display
        0xAF        // Display ON
    };

    for (int i = 0; i < sizeof(init_cmds); i++) {
        oled_write_command(init_cmds[i]);
    }
}

// Clear OLED display
void oled_clear() {
    uint8_t zero[OLED_WIDTH] = {0};
    for (int page = 0; page < OLED_PAGES; page++) {
        oled_write_command(0xB0 + page); // Set page
        oled_write_command(0x00);       // Set low column address
        oled_write_command(0x10);       // Set high column address
        oled_write_data(zero, OLED_WIDTH);
    }
}

// Set cursor position (in pixels)
void oled_set_cursor(uint8_t x, uint8_t page) {
    oled_write_command(0xB0 + page); // Set page
    oled_write_command(x & 0x0F);    // Set low column address
    oled_write_command(0x10 + (x >> 4)); // Set high column address
}

// Draw a single character using font8x8_basic
void oled_draw_char(char c, uint8_t x, uint8_t page) {
    if (c < 32 || c > 126) c = 32; // Default to space for unsupported chars
    oled_set_cursor(x, page);
    oled_write_data(font8x8_basic[c - 32], 8);
}

// Draw a string
void oled_draw_string(const char *str, uint8_t x, uint8_t page) {
    int i = 0;
    while (str[i] && x + i * 8 < OLED_WIDTH) {
        oled_draw_char(str[i], x + i * 8, page);
        i++;
    }
}

int app_spi_oled_main(int argc, char *argv[]) {
    if (argc != 3) {
        fprintf(stderr, "Usage: %s <spidev> <gpio_number>\n", argv[0]);
        fprintf(stderr, "Example: %s /dev/spidev0.1 524\n", argv[0]);
        return -1;
    }

    // Open SPI device
    spi_fd = open(argv[1], O_RDWR);
    if (spi_fd < 0) {
        perror("Failed to open SPI device");
        return -1;
    }

    // Set SPI mode
    if (ioctl(spi_fd, SPI_IOC_WR_MODE32, &mode) < 0) {
        perror("Failed to set SPI mode");
        close(spi_fd);
        return -1;
    }

    // Set bits per word
    if (ioctl(spi_fd, SPI_IOC_WR_BITS_PER_WORD, &bits) < 0) {
        perror("Failed to set SPI bits per word");
        close(spi_fd);
        return -1;
    }

    // Set SPI speed
    if (ioctl(spi_fd, SPI_IOC_WR_MAX_SPEED_HZ, &speed) < 0) {
        perror("Failed to set SPI speed");
        close(spi_fd);
        return -1;
    }

    // Open GPIO
    char gpio_path[64];
    snprintf(gpio_path, sizeof(gpio_path), "/sys/class/gpio/gpio%s/value", argv[2]);
    gpio_fd = open(gpio_path, O_RDWR);
    if (gpio_fd < 0) {
        perror("Failed to open GPIO");
        close(spi_fd);
        return -1;
    }

    // Initialize OLED
    oled_init();

    // Clear display
    oled_clear();

    // Draw sample text
    oled_draw_string("Hello OLED!", 0, 0);

    // Clean up
    close(gpio_fd);
    close(spi_fd);
    return 0;
}